{
  "name": "task-tree",
  "packageManager": "yarn@4.14.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @task/app dev",
    "build": "yarn workspaces foreach -A -v run build",
    "lint": "yarn workspaces foreach -A -v run lint",
    "lint:fix": "yarn workspaces foreach -A -v run lint --fix",
    "format": "yarn prettier --write .",
    "test:api": "yarn workspace @task/api test",
    "test:e2e": "playwright test",
    "type-check": "yarn workspaces foreach -A -v run type-check",
    "type-check:ui": "yarn workspace @task/ui type-check",
    "type-check:core": "yarn workspace @task/core type-check",
    "type-check:api": "yarn workspace @task/api type-check",
    "deploy:infra": "yarn workspace @task/infra deploy",
    "esbuild": "esbuild"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.9.0",
    "eslint-config-next": "^15.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "uuid": "^14.0.0"
  }
}
